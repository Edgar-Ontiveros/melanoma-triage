# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Herramientas
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.pre-commit-cache/

# Salidas de corridas (Hydra, Lightning, wandb)
outputs/
multirun/
lightning_logs/
wandb/
logs/*
!logs/.gitkeep
!logs/test_set_access.log

# Datos y pesos: nunca al repositorio
data/raw/
# DDI (Stanford AIMI): el acuerdo de uso prohíbe redistribuirlo. Explícito además de data/raw/.
data/raw/ddi/
data/processed/
data/**/*.jpg
data/**/*.png
data/**/*.csv
!data/manifests/.gitkeep
!data/manifests/isic2020.csv
!data/splits/.gitkeep
!data/splits/*.txt
!data/splits/SHA256SUMS
# Reportes: se versionan md y figuras; los intermedios pesados no
reports/*.npy
reports/*.npz
# Kaggle: el dataset se arma en kaggle/dataset/ a partir de archivos ya versionados
kaggle/dataset/
*.ckpt
# Checkpoints descargados de Kaggle (F4): nunca al repositorio
data/models/
*.pt
*.pth
*.onnx

# Editor / SO
.vscode/
.idea/
.DS_Store
# Corridas offline de W&B bajadas de Kaggle: se sincronizan con `kaggle_run.py sync-wandb`, no se versionan
reports/runs/**/wandb/
