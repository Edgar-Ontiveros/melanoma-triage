# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Herramientas
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.pre-commit-cache/

# Salidas de corridas (Hydra, Lightning, wandb)
outputs/
multirun/
lightning_logs/
wandb/
logs/*
!logs/.gitkeep
!logs/test_set_access.log

# Datos y pesos: nunca al repositorio
data/raw/
data/processed/
data/**/*.jpg
data/**/*.png
data/**/*.csv
!data/manifests/.gitkeep
!data/manifests/isic2020.csv
!data/splits/.gitkeep
!data/splits/*.txt
!data/splits/SHA256SUMS
# Reportes: se versionan md y figuras; los intermedios pesados no
reports/*.npy
reports/*.npz
# Kaggle: el dataset se arma en kaggle/dataset/ a partir de archivos ya versionados
kaggle/dataset/
*.ckpt
*.pt
*.pth
*.onnx

# Editor / SO
.vscode/
.idea/
.DS_Store
